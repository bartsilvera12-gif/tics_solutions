# Plantilla de las variables del proyecto.
#
# Este archivo es solo documentación: no lleva valores reales y sí va al
# repositorio. Los valores de verdad viven en .env.local, que está ignorado
# por git, y en el panel del hosting.
#
# NUNCA poner acá una clave real. Antes de commitear, revisar `git status`.

# ---------- correo (formulario de contacto) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=arturo.osorio@tics-py.com

# Contraseña de aplicación de Google para esa cuenta, NO la del correo.
# Se genera en la cuenta de Google, con verificación en dos pasos activada.
SMTP_PASSWORD=

CONTACT_EMAIL=arturo.osorio@tics-py.com

# ---------- base de datos ----------
# Solo para correr migraciones y seeds desde una máquina de desarrollo.
# El sitio y el panel no la usan: hablan con PostgREST.
DATABASE_URL=

# ---------- supabase ----------
# La URL y la anon key son públicas: van en js/config.js y las ve cualquiera
# que abra el sitio. Están acá para tener el juego completo en un solo lugar.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# La service_role saltea RLS por completo. NUNCA en el navegador, nunca en
# js/config.js, nunca en un commit.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=tics-media

# ---------- panel administrador ----------
# El panel usa las sesiones de Supabase Auth, así que no hay secreto propio
# de sesión. Esta variable queda reservada por si más adelante se agrega un
# backend con cookies firmadas.
ADMIN_SESSION_SECRET=

# El primer administrador NO se crea con estas variables: se da de alta a
# mano en Supabase (Authentication -> Users -> Add user) y después se corre
# supabase/migrations/007_ticspy_primer_admin.sql, que le asigna el rol.
# Así la contraseña la hashea Supabase y no pasa por ningún archivo.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
