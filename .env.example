# Plantilla de las variables que necesita la función de contacto.
# Este archivo es solo documentación: no lleva valores reales y sí va al
# repositorio. Los valores de verdad se cargan en Vercel, en
# Settings -> Environment Variables, y no se escriben en ningún archivo.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=consulta@tics-py.com

# Contraseña de aplicación de Google para esa cuenta, NO la del correo.
# Se genera en la cuenta de Google, con verificación en dos pasos activada.
SMTP_PASSWORD=

CONTACT_EMAIL=consulta@tics-py.com
